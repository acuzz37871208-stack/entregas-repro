{
  "rules": {
    "entregas": {
      ".read": true,
      ".write": "auth != null",
      "$entregaId": {
        ".validate": "newData.hasChildren(['persona', 'genetica', 'gramos', 'fecha'])"
      }
    },
    "pacientes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "pedidos": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "geneticas": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    ".read": false,
    ".write": false
  }
}
